{
  "pluginAlias": "knx-door",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "ip": {
        "title": "KNX Router or Interface",
        "type": "string",
        "placeholder": "224.0.23.12",
        "default": "224.0.23.12",
        "description": "IP address of the KNX router or interface."
      },
      "port": {
        "title": "KNX Port",
        "type": "integer",
        "minimum": 1,
        "maximum": 65535,
        "placeholder": 3671,
        "default": 3671,
        "description": "KNX/IP port."
      },
      "devices": {
        "title": "Door & Window Contact Sensors",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "name",
            "listen"
          ],
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "minLength": 1,
              "placeholder": "Display Name for Door or Window Contact Sensor"
            },
            "listen": {
              "title": "Listen Address",
              "type": "string",
              "placeholder": "1/1/1",
              "pattern": "^[0-9]{1,4}/[0-9]{1,4}/[0-9]{1,4}$"
            }
          }
        }
      }
    },
    "required": [
      "devices"
    ]
  },
  "layout": [
    {
      "key": "devices",
      "type": "array",
      "orderable": false,
      "buttonText": "Add Door or Window Contact Sensor",
      "items": [
        "devices[].name",
        "devices[].listen"
      ]
    },
    {
      "type": "section",
      "title": "Global",
      "expandable": true,
      "expanded": false,
      "items": [
        "ip",
        "port"
      ]
    }
  ]
}
